@article{snowball_101109icmcsi61536202400048,
title = {Real-Time Tracking of Medical Histories During Accident},
abstract = {Patient health records are stored in the cloud securely, ensuring data availability, redundancy, and scalability. Cloud infrastructure providers often employ industry-leading security measures to safeguard sensitive medical data. In the realm of modern healthcare, the rapid and secure sharing of patient health records during emergency situations stands as a critical challenge. To address this challenge, a novel system has been proposed to enable patient identification through fingerprint and a unique QR code. Patients' medical records, including personal information, medical history, and allergies, are stored in a highly secure database with advanced encryption to protect sensitive data. The proposed system provides a secure database to store patient information, biometric fingerprint verification for patient identification, and unique QR codes for individual patient records. In the event of a medical emergency, authorized healthcare professionals can access patients' critical data through a secured portal. During emergency situation, this system empowers third-party individuals, to send immediate emergency notifications to a patient’s designated doctor or caretaker, ensuring timely and life-saving interventions. Consent mechanisms, robust authentication protocols, and verification based data sharing ensures privacy and compliance with relevant healthcare regulations. The project prioritizes usability, scalability, and data security, incorporating continuous maintenance and updates to adapt to evolving healthcare technology and security standards. This system aims to revolutionize patient care by facilitating swift, secure, and accurate access to vital medical information, ultimately improving healthcare outcomes.},
