@article{snowball_101109macs68476202511453408,
title = {Building Spoofing-Resilient Architectures for Future Iot Networks},
abstract = {The fast expansion of Internet of Things (IoT) devices has created substantial problems, most notably spoofing attacks that jeopardize data integrity and network stability. Traditional security techniques frequently fall short of meeting the constantly changing and flexible requirements of IoT networks. This study presents a novel paradigm for constructing futureoriented IoT networks that have characteristics that are naturally vulnerable to spoofing assaults using machine learning (ML) approaches. Our method uses powerful ML techniques, such as identifying anomalies and behavioural evaluation, to detect and counteract faking operations in real time. We investigate the suggested architecture in a simulated IoT context, proving its capacity for attaining excellent detection accuracy while minimizing false-positive rates. In addition, we explain how the system provides flexibility and versatility to various IoT applications, assuring comprehensive safety without sacrificing speed. The findings demonstrate machine learning's effectiveness in constructing spoofing-free IoT networks, opening the path for safer and more dependable implementations of IoT in important fields including smart cities, medical treatment, and automated manufacturing.},
