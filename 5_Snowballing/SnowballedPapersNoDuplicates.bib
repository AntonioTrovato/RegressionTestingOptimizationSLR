@misc{snowball_101109isaeece66033202511159917,
title = {A Comprehensive Review on Test Case Generation and Prioritization in Software Combinatorial Testing},
abstract = {Combinatorial testing, as a critical approach to safeguarding software quality, effectively identifies potential defects caused by multi-factor interactions through two core technologies: covering array generation and test case prioritization, significantly reducing testing costs. This paper systematically reviews the technological evolution in combinatorial testing over the past decade, highlighting three major trends: 1. Covering array generation algorithms have shifted from single-strategy approaches to hybrid intelligent paradigms, integrating mathematical construction methods (e.g., orthogonal arrays), heuristic algorithms (e.g., genetic algorithms, ant colony optimization), and metaheuristic optimizations. 2. Optimization objectives have expanded from static metrics to multi-dimensional dynamic trade-offs, leveraging multi-objective optimization and machine learning to enhance testing efficiency. 3. Application scenarios have transitioned from closed systems to open environments such as IoT and edge computing. The study emphasizes emerging challenges posed by technologies like digital twins and real-time constraints, including ultra-large-scale parameter processing and dynamic multi-objective optimization. Further integration of artificial intelligence (AI) with testing technologies is imperative to establish more efficient quality assurance frameworks for strategic industries such as smart manufacturing and autonomous driving.},
