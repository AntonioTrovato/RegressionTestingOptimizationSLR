@article{snowball_101016jjss2026112886,
title = {Observability of web applications: An industrial case study},
abstract = {Berger-Levrault (BL), an international software publisher, relied on traditional logging approaches to collect event data from its web applications. These approaches require developers to insert and maintain explicit instrumentation code snippets across multiple projects, leading to inconsistent data, limited visibility for non-technical stakeholders as well as significant maintenance and performance overhead. To address these issues, BL initiated an effort to adopt an observability approach for its web applications. In this paper, we report our industrial experience in designing, implementing, and evaluating an observability approach across four large-scale web applications at BL. We describe how we identify the observability data required by two critical activities at BL: improving user experience and automated test generation. We show how we implement automated, non-invasive instrumentation approaches to gather the required data without modifying the codebase by extending the automatic instrumentation capabilities of OpenTelemetry agents. We also define an observability architecture that integrates observability components seamlessly with BL applications. Our industrial evaluation shows that the approach collects all required data while keeping performance overhead low and acceptable for production environments. Beyond demonstrating feasibility, we distill practical guidelines and lessons learned to support practitioners seeking to introduce observability in similar industrial contexts.},
