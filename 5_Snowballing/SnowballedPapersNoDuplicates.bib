@article{snowball_101109icaiset66439202611541865,
title = {Shaping QA Coverage with Production Telemetry: Risk-Based Test Selection Under CI Budget Constraints},
abstract = {Continuous integration (CI) pipelines for cloud-native microservices face a resource allocation problem in which test suites grow beyond time budgets, forcing subset selection. Static strategies (fixed ordering, historical pass rates) ignore runtime system behavior, producing test distributions misaligned with production traffic. We propose a telemetry-driven test selection strategy that queries OpenTelemetry metrics to compute per-service risk scores and greedily selects tests by risk-adjusted priority under a fixed CI time budget. The telemetry-driven pipeline reduces the divergence of coverage from production traffic by 64.8% (p < 0.001), improves the fault detection rate from 67% to 94% (p = 0.0253), and increases the regression detection throughput by 60% (p = 0.0013), without increasing the CI runtime. The primary mechanism is improved test selection, that is, shaping the test execution distribution to match production risk, rather than faster execution ordering.},
doi = {10.1109/icaiset66439.2026.11541865},
year = {2026},
pages = {1-6},
note = {Found via snowballing (OpenAlex)}
}

@article{snowball_10114537485223779891,
title = {Recommending Test Cases in Agile Software Development with a Taxonomy-Guided KNN Approach},
abstract = {Context: Agile testing faces unique challenges, including short cycles, evolving requirements, and the constant need to update test suites. Reusing validated test cases can improve coverage and efficiency, but it is often hindered by fragmented documentation and evolving repositories. Objective: This study introduces a Recommender System (RecSys) to support test case reuse in agile contexts by exploiting historical user stories and a domain-specific taxonomy. Method: We implemented a K-Nearest Neighbors (KNN)-based Rec-Sys that retrieves user stories similar to a target and recommends their associated test cases. The approach emphasizes transparent and interpretable recommendations. We assessed it through a multi-method design: (i) an offline experiment with 217 user stories and 1,077 test cases from two companies to identify the best configuration using recall, precision, and F-measure; and (ii) an online case study in two agile projects to evaluate its real-world impact. Results: In the offline phase, the best configuration reached 67.5% recall, 37.8% precision, and an F2 score of 51%. In the online pilot, recall remained similarly high at 65.1%, while precision rose substantially to 63.1%, alongside a 38.8% expansion of the test suite. Conclusion: These findings show that our taxonomy-based RecSys effectively supports test reuse in agile settings, yielding consistent results both offline and in real-world settings. Its transparent logic, low infrastructure needs, and alignment with agile workflows make it a lightweight and practical alternative to more complex reuse solutions.},
doi = {10.1145/3748522.3779891},
year = {2026},
pages = {1708-1716},
note = {Found via snowballing (OpenAlex)}
}

@misc{snowball_356,
title = {Actor-critic algorithms},
abstract = {Abstract. In this article, we propose and analyze a class of actor-critic algorithms. These are two-time-scale algorithms in which the critic uses temporal difference learning with a linearly parameterized approximation architecture, and the actor is updated in an approximate gradient direction, based on information provided by the critic. We show that the features for the critic should ideally span a subspace prescribed by the choice of parameterization of the actor. We study actor-critic algorithms for Markov decision processes with Polish state and action spaces. We state and prove two results regarding their convergence.},
year = {2002},
booktitle = {DSpace@MIT (Massachusetts Institute of Technology)},
