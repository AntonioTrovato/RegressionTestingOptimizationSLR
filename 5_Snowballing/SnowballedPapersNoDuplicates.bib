@article{snowball_1051903teknikv1i1323,
title = {Analisis Tes Flakiness Untuk Machine Learning Menggunakan Python},
abstract = {Main Objective: Tujuan dari penelitian ini adalah untuk mengetahui penyebab dari flaky test yang paling umum terjadi pada proyek Python dengan membandingkan penelitian yang berfokus pada proyek Java sebelumnya. Background problem: Tes tidak stabil dapat gagal atau lulus tanpa ada perubahan pada kode yang diuji, ini dapat menghancurkan kepercayaan pengembang pada rangkaian pengujian dan jika diabaikan menyebabkan bug dalam kode yang dirilis. Novelty: penelitian menggunakan pendekatan empiris dari proyek Python open-source paling populer di GitHub. Sejumlah 197 komitmen dengan kata kunci yang menunjukkan kelemahan uji diperiksa secara manual dan dikategorikan menurut akar penyebab kelemahan masing-masing. Research Method: metode analisis pengujian flakiness digunakan dengan urutan tahap filtering commit dan dua analisis. Finding/Result: hasil penelitian dibandingkan dengan studi proyek Java sebelumnya, dan ditemukan dua penyebab kelemahan yakni presisi dan pelatihan (jaringan Machine learning). Flakiness presisi disebabkan oleh pernyataan dengan ambang batas yang terlalu tinggi atau terlalu rendah. Kelemahan pelatihan disebabkan oleh pengaturan pelatihan yang salah dari jaringan Machine learning dalam pengujian. Sebagian besar tes dalam proyek Python ditemukan tidak stabil karena masalah dengan menunggu asinkron, presisi, dan jaringan. Conclusion: Developer Python dimasa depan akan mendapat manfaat dari pengetahuan tentang jebakan umum yang dapat menyebabkan kelemahan dalam rangkaian pengujian mereka. Hasil dari penelitian ini dapat digunakan sebagai referensi bagi para peneliti di masa depan dengan area penlitian tes flakiness atau area serupa lainnya..},
doi = {10.51903/teknik.v1i1.323},
year = {2023},
journal = {Teknik Jurnal Ilmu Teknik dan Informatika},
pages = {55-72},
note = {Found via snowballing (OpenAlex)}
}

@article{snowball_101109icosec67334202511459654,
title = {Hybrid Adaptive Optimization for Cloud Test Case Prioritization},
abstract = {To prioritise test cases in distributed cloud financial systems, a Hybrid Adaptive Optimization Framework is presented in this paper. It is to improve performance by adaptive algorithms and evolutionary methodologies in some trade-offs of fault detection ability, execution time and code coverage. My goal is to develop an automation solution that calibrates its approach by weighing factors such as code coverage, execution time, and fault detection in a cloud-based financial system that is constantly evolving and demanding. The architecture combines a hybrid firefly-genetic algorithm, k-medoids clustering, LSTM-based change detection, and T-SNE-based features reduction. This feedback loop ensures that the software updates are always adapted to, logically creating prioritized test cases for financial cloud systems. Hyperparameter Optimization Algorithms: The novel Hybrid Firefly-GA framework not only departs fundamentally from the methods dealt with earlier but also achieves an exemplary finish of 99.10%, trims the running period by 25%, and optimizes precision to 99.12%. The Hybrid Firefly-GA model introduces a new methodology and enhances performance compared to baseline methods in the prioritization segment, which supports effective test case prioritization. It is able to guarantee test case prioritization value in terms of critical metrics such as defect identification and testing time reduction for financial cloud applications.},
doi = {10.1109/icosec67334.2025.11459654},
year = {2025},
pages = {1385-1390},
note = {Found via snowballing (OpenAlex)}
}

@article{snowball_101109ase2001989787,
title = {TestEra: a novel framework for automated testing of Java programs},
abstract = {We present TestEra, a novel framework for automated testing of Java programs. TestEra automatically generates all non-isomorphic test cases within a given input size and evaluates correctness criteria. As an enabling technology, TestEra uses Alloy, a first-order relational language, and the Alloy Analyzer. Checking a program with TestEra involves modeling the correctness criteria for the program in Alloy and specifying abstraction and concretization translations between instances of Alloy models and Java data structures. TestEra produces concrete Java inputs as counterexamples to violated correctness criteria. The paper discusses TestEra's analyses of several case studies: methods that manipulate singly linked lists and red-black trees, a naming architecture, and a part of the Alloy Analyzer.},
doi = {10.1109/ase.2001.989787},
year = {2005},
note = {Found via snowballing (OpenAlex)}
}

