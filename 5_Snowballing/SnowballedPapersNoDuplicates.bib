@article{snowball_101109isitia66279202511137471,
title = {Cost-Efficient Software Test Case Prioritization by Integrating Attributes Using Reinforcement Learning},
abstract = {In software testing, time and cost limitations make it impossible to execute each test case in every iteration. This study presents an approach to prioritize test case by integrating three key attributes: complexity, cost, and priority weight. By utilizing reinforcement learning (RL), we aim to find an effective sequence of test cases that maximizes overall testing efficiency. The decision-making process using the model is guided by finding maximum reward mechanism, which ensures that the selected test cases contribute significantly to the testing objectives. The results demonstrate a coverage of 62.68% and cost reduction as much as 19.28% compared to Lowest-Time Approach and 17.72% compared to Highest-Priority Approach. Using a wide variety of datasets in future research is highly recommended to avoid bias and validate the model's ability to work effectively with various software characteristics.},
