@article{snowball_101109bddm68348202511442199,
title = {An Application of Test Case Priority Sorting in an Automated Testing System},
abstract = {Automation testing plays a pivotal role in modern industrial production. While hardware-based automated testing can substantially improve testing efficiency, the complexity and uncertainty inherent in hardware environments impose higher demands on test effectiveness and fault detection capability. In recent years, Test Case Prioritization (TCP) has been thoroughly researched and widely implemented in numerous software testing contexts; however, its application to hardware testing remains limited. To fill this gap, this paper introduces ATOrder, a method specifically designed for prioritizing test cases in industrial settings. By utilizing deep learning techniques, ATOrder prioritizes test cases in the current cycle, drawing on the execution history from previous cycles. It automatically extracts useful historical information and derives features of test cases from multiple perspectives. We designed experiments using public datasets and tested the model in real-world environments. The results indicate that our proposed ATOrder offers significant advantages in enhancing the efficiency of automated acceptance testing.},
