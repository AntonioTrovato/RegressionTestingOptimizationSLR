@article{snowball_101109sces5043920209236748,
title = {Automation of Tests and Comparative Analysis between Manual and Automated testing},
abstract = {A hardware-in-the-loop simulated test bench permits a test engineer to estimate the characteristics of a system without building the actual and complete system. In automotive industries, the tests concentrate on the performance of software logics flashed into the ECMs or ACMs to check its proper functioning. This paper describes the automation of manually performed tests on HIL test bench set up. Manual performance of tests has the disadvantage of consuming more time than automated test performance in terms of setting up of the test bench and execution of tests. A HIL manual test bench set up consists of hardware like wiring harness, PCAN adapter, electronic/after-treatment control module (ECM/ACM) and different sensors and actuators. The automation is done by scripting in NI Test Stand using LUIS Box as the engine simulator and ECM and LUIS specific wiring harness along with the hardware used in manual test bench set up.},
