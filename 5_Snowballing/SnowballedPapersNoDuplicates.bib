@article{snowball_101109macs56771202210022719,
title = {Design of a MEMS Meander Switch and Comparison of its RF Performances with a Basic Shunt Switch at DC to 40 GHz},
abstract = {This paper represents the design and simulation of the Micro-electro-mechanical system (MEMS) meander switch and compares its RF performance with basic shunt switch using HFSS software at an operating frequency of 40 GHz. The RF performance (Return loss, Insertion loss, and Isolation) of basic shunt switch (n=15) is compared with meander switch (n=15) at a frequency range of 40 GHz. The 15 samples were calculated by sample calculation with pre-test power 80 %. Meander switch has significantly better RF performances (Return loss: −34.1418 dB, Insertion loss: 0.0744 dB, Isolation: −21.8062 dB) than the basic shunt switch (Return loss: −25.4102 dB, Insertion loss: −0.086 dB, Isolation: −26.8565 dB). The optimized dimensions for maximum RF performances was lb =265 m, wb = 95 m, tb = 1 m, for meander switch and basic shunt switch. Attained significant RF performances value (Pi0.001). The obtained results appear to have significantly better RF performances in the novel meander switch than basic shunt switch.},
