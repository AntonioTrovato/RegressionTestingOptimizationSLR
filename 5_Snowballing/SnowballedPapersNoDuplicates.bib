@article{snowball_101109icsme201630,
title = {Customized Regression Testing Using Telemetry Usage Patterns},
abstract = {Pervasive telemetry in modern applications is providing new possibilities in the application of regression testing techniques. Similar to how research in bioinformatics is leading to personalized medicine, tailored to individuals, usage telemetry in modern software allows for custom regression testing, tailored to the usage patterns of an installation. By customizing regression testing based on software usage, the effectiveness of regression testing techniques can be greatly improved, leading to reduced testing costs and enhanced detection of defects that are most important to that customer. In this research, we introduce the concept of fingerprinting software usage patterns through telemetry. We provide various algorithms tocompute fingerprints and conduct an empirical study that shows that fingerprints are effective in identifying distinct usage patterns. Further, we discuss how usage fingerprints can be used to improve regression test prioritization run time by over 30 percent compared to traditional prioritization techniques.},
doi = {10.1109/icsme.2016.30},
year = {2016},
pages = {572-581},
note = {Found via snowballing (OpenAlex)}
}

@article{snowball_101109andescon20188564666,
title = {New Approach to Develop Knowledge-Based System for Environmental Conflicts Analysis Using Fuzzy Logic and Grey Systems},
abstract = {The analysis of environmental conflicts is of vital importance to verify the viability and analyze the impact of projects in environments with a social presence The grey systems facilitate the obtaining of knowledge in environments that are not very clear or with little information and the diffuse logic allows through linguistic variables and fuzzy sets to represent the conceptual knowledge in the computer and the IF-THEN rules allow to make the inference based on those concepts and give conceptual results easily accessible to people. In this paper we propose a approach to develop systems based on knowledge using grey systems and fuzzy logic for analysis of environmental conflicts during all phases of projects A test is carried out using the case study data in [1] of a mining project in northern Peru and a knowledge-based system that can be used for the analysis of environmental conflicts during all phases of the project or for analysis in environments with similar characteristics is implemented.},
