@article{snowball_103389frai20261776546,
title = {AI-augmented reliability in CI/CD: a framework for predictive, adaptive, and self-correcting pipelines},
abstract = {Modern CI/CD pipelines face a critical challenge. While AI tools accelerate code generation, static pipelines have become the primary bottleneck to delivery velocity. Flaky tests and pipeline noise create a persistent challenge, with reported failure rates ranging from 11 to 27 percent for test flakiness and 5-16 percent for noise-induced build failures. This forces teams to spend more time investigating false failures than building features. As systems scale across regions and dependencies, these problems compound and threaten the fundamental promise of continuous delivery. We introduce a framework that transforms CI/CD pipelines from deterministic scripts into intelligent, adaptive systems. At its core is the Sense-Analyze-Predict-Act-Learn loop, which we call SAPAL. This loop extends classical adaptive models with CI/CD specific capabilities including flakiness characterization, dependency risk scoring, multi-region awareness, and developer feedback. We operationalize this loop through a five-layer architecture spanning data collection, reliability intelligence, predictive modeling, adaptive execution, and human-AI collaboration. Three novel metrics quantify pipeline intelligence. Pipeline Health Index measures overall reliability. Test Stability Score identifies flaky patterns. Failure Prediction Confidence validates model accuracy. Three scenarios demonstrate application to real CI/CD challenges. Intelligent retry strategies, grounded in empirical studies of flaky test detection and resolution, project 60 percent reduction in flaky-induced build failures. ML-based test selection techniques from recent literature suggest 50 to 80 percent reduction in feedback time. Stability-aware deployment orchestration adapts rollout strategies to regional reliability patterns. These projections synthesize findings from published component studies rather than measurements from unified framework deployment. By enabling pipelines to learn from executions, predict with calibrated confidence, and adapt to behavior patterns, this framework provides a practical path toward reliable delivery at scale where intelligence is essential, not optional.},
doi = {10.3389/frai.2026.1776546},
year = {2026},
journal = {Frontiers in Artificial Intelligence},
pages = {1776546-1776546},
note = {Found via snowballing (OpenAlex)}
}

@article{snowball_101109access20263683914,
title = {Adaptive and Explainable Test Case Prioritization in Continuous Integration: A Systematic Review of Reinforcement Learning, Learning-to-Rank, and Search-/Combinatorial-Based Methods},
abstract = {Continuous Integration requires fast fault exposure under strict time budgets. Test case prioritization orders regression tests to expose failures early while respecting budget limits and operational constraints. A systematic review of 73 studies published during 2020–2025 synthesizes evidence on adaptive and explainable prioritization for CI, organized into learning-driven ranking (learning-to-rank, reinforcement learning, neural rankers, history-only models), multi-armed bandits for volatile test pools, and search/combinatorial optimization for selection and ordering. Adjacent evidence on compute-bounded input prioritization for AI/ML systems is summarized to extract transferable patterns in cost control and explanation. Results show a consistent cost–effectiveness gradient: history-only rankers and volatile bandits achieve strong early-fault yield with sub-second decision time, while structure-aware models provide additional benefit only when feature extraction is incremental and retraining is scheduled to limit model decay. Reinforcement learning performs best when reward design uses time-aware credit assignment and explicit memory to handle sparse failures. Multi-objective search reaches strong trade-offs but requires evaluation caps, cached orders, or pre-filtering by safe regression-test selection to satisfy CI latency. Many studies report effectiveness without synchronized reporting of end-to-end cost, flakiness settings, and safety metrics such as failure recall and precision. Outputs include a taxonomy of signals and method families, a PRISMA-auditable study selection flow, an evidence matrix capturing datasets, metrics, and overhead, a sensitivity analysis for the cost-reporting inclusion criterion, and a decision framework for selecting deployable approaches under CI constraints. A replication package provides the evidence matrix and aggregation scripts.},
doi = {10.1109/access.2026.3683914},
year = {2026},
journal = {IEEE Access},
pages = {59241-59264},
note = {Found via snowballing (OpenAlex)}
}

