@article{snowball_101109itaic5421620229836666,
title = {Test Cases Selection Method of Rapid Regression Testing},
abstract = {Regression testing is important for detecting software defects. Selecting test cases for regression testing is a key step. Retry all test cases strategy can make tester keep confidence in regression testing, but it requires much time and resources. Minimum test case set strategy becomes a good choice in recent years. However, it only focuses on how to filtering previous test cases. This paper talks about a test cases selection method, which not only incudes filtering previous test cases but also includes designing new test cases. In detail, this paper talks about the test cases selection method from the designing process and the execution results of test cases to filter previous test cases, and the exploratory testing method to design new test cases. In practical work, this method can saves a lot of time and resources too.},
