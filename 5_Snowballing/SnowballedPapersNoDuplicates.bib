@article{snowball_1017863cam132164,
title = {Learning from Delayed Rewards},
abstract = {In behavioural ecology, stochastic dynamic programming may be used as a general method for calculating animals' optimal behavioural policies. But how might the animals themselves learn optimal policies from their experience? The aim of the thesis is to give a systematic analysis of possible computational methods of learning efficient behaviour. First, it is argued that it does not follow from the optimality assumption that animals should learn optimal policies, even though they may not always follow them. Next, it is argued that Markov decision processes are a general formal model of an animal's behavioural choices in its environment. The conventional methods of determining optimal policies by dynamic programming are then described. It is not plausible that animals carry out calculations of this type. However, there is a random of alternative methods of organising the dynamic programming calculation, in ways that are plausible computational models of animal learning. In particular, there is an incremental Monte-Carlo method that enables the optimal values (or 'canonical costs') of actions to be learned directly, without any requirement for the animal to model its environment, or to remember situations and actions for more than a short period of time. A proof is given that this learning method works. Learning methods of this type are also possible for hierarchical policies. Previously suggested learning methods are reviewed, and some even simpler learning methods are presented without proof. Demonstration implementations of some of the learning methods are described.},
doi = {10.17863/cam.132164},
year = {1989},
journal = {OpenGrey (Institut de l'Information Scientifique et Technique)},
note = {Found via snowballing (OpenAlex)}
}

@misc{snowball_1056975tijerv12i6158253,
title = {Transforming Software Quality Assurance: A Systematic Review of AI-Driven Testing Innovations},
abstract = {Artificial intelligence technologies are fundamentally reshaping software testing practices across the industry, yielding significant improvements in efficiency, effectiveness, and test coverage. Large Language Models now demonstrate remarkable capabilities in automatically generating comprehensive test suites directly from natural language requirements and source code, while computer vision algorithms enable more accurate detection of visual regressions with reduced false positives. Concurrently, advanced anomaly detection systems leverage machine learning to identify potential quality issues through log analysis and performance metric evaluation before end-users experience failures. The integration of reinforcement learning techniques for test case prioritization within continuous integration pipelines has dramatically reduced feedback cycles while maintaining defect detection rates. These technological advancements collectively represent a paradigm shift in quality assurance, enabling testing teams to achieve greater coverage with fewer resources while adapting to increasingly complex software architectures and accelerated delivery timelines. The evidence suggests these AI-driven innovations will continue to evolve, potentially transforming the role of human testers toward higher-value activities while algorithms handle repetitive testing tasks.},
doi = {10.56975/tijer.v12i6.158253},
