@article{snowball_101109wmed71264202611509667,
title = {Machine Learning-Based Flaky Test Detection and Suppression for UVM Verification Regressions},
abstract = {Universal Verification Methodology (UVM) regression testing suffers from a critical productivity bottleneck: non-deterministic test failures triggered by race conditions, X-propagation, and uninitialized signal accesses consume substantial engineering resources during triage. Industry data indicates that $\mathbf(3 0 - 4 5 \%)$ of reported UVM regression failures are non-actionable, yet current approaches to classification remain predominantly manual and reactive. We present a machine learning framework that automatically identifies and suppresses these flaky failures by analyzing failure signatures, seed sensitivity patterns, and temporal correlations in simulation logs. Our two-stage pipeline combines an instrumented feature extractor with a gradient-boosted decision tree (GBDT) classifier. We describe the complete framework architecture and feature engineering methodology, supported by two detailed case studies drawn from industrial regression practice. Based on analogous results in software flaky test detection and the statistical properties of our feature design, the framework is targeting precision above $90 \%$ and targeting mean-time-to-actionable-bug (MTTA) reduction by $\mathbf(3 5 - 5 0 \%)$ while requiring fewer than three reruns per failure on average. Full quantitative validation on an open-source UVM testbench is in preparation; the testbench infrastructure is in place and results will be reported in the extended version. By automatically suppressing non-actionable failures, the framework directly reduces verification cycle time and lowers the risk of schedule slippage and silicon respin costs attributable to engineer effort misdirected at testbench artifacts rather than real design defects.},
doi = {10.1109/wmed71264.2026.11509667},
year = {2026},
pages = {14-20},
note = {Found via snowballing (OpenAlex)}
}

