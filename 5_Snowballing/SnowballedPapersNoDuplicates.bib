@article{snowball_1026599tst20249010078,
title = {Prioritization of Abstract Test Cases by Weighting Covered Value Combinations},
abstract = {Abstract Test Cases (ATCs) have been widely used in practical scenarios such as combinatorial testing. When the set of ATCs is constructed, Test Case Prioritization (TCP) is applied to improve the testing quality. Among the many TCP approaches for ATCs, one intuitive and well-studied approach is Interaction Coverage Based Prioritization (ICBP), which greedily identifies one element as the next ATC such that it covers the largest number of uncovered -wise parameter-value combinations. When a -wise value combination, vc, has been covered by the already-selected ATCs, it is generally believed that it may have no further role to play in the ICBP process. However, each already-covered vc may provide some potential contributions for the interaction coverage of the strength higher than . Motivated by this, we propose a new TCP approach to prioritize ATCs, Weighted Interaction Coverage Based Prioritization (WICBP). WICBP attempts to assign a weight to each -wise value combination that has already been covered. The experimental results show that when using the same prioritization strength, WICBP is more effective than ICBP but maintains comparable testing efficiency. In addition, WICBP with lower prioritization strengths achieves surprisingly competitive (even better) performance compared with ICBP with higher prioritization strengths.},
doi = {10.26599/tst.2024.9010078},
year = {2025},
journal = {Tsinghua Science & Technology},
pages = {460-483},
note = {Found via snowballing (OpenAlex)}
}

@article{snowball_101109tcset65181202611461202,
title = {Adaptive Reinforcement Learning–Based Test Selection for Improving Web Application Testing Accuracy},
abstract = {This paper presents an approach for improving the accuracy of automated testing of web applications through adaptive test scenario prioritization using reinforcement learning. The proposed model enables an agent to learn from past test execution data and dynamically adjust its prioritization strategy to detect defects earlier under limited testing budgets. An experimental study was conducted on three open-source web applications using real test suites and several baseline selection strategies, including random choice, change-based prioritization, and coverage-based ordering. Quantitative evaluation, based on the proportion of defects detected within a fixed subset of tests, the average rate of early fault identification, and mutation testing performance, demonstrates that the proposed reinforcement learning method achieves significantly higher accuracy and faster defect localization compared to traditional approaches. These improvements were further validated using the Wilcoxon statistical test. The results highlight the potential of reinforcement learning for building adaptive test prioritization systems in modern web applications and for integrating such methods into CI/CD pipelines.},
doi = {10.1109/tcset65181.2026.11461202},
year = {2026},
pages = {1-5},
