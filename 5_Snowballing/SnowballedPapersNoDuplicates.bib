@article{snowball_10114535357823535808,
title = {Student Project Management System (SPMS)},
abstract = {Most undergraduate programs in Thailand require their students to develop student projects as the partial fulfilment of the program completion. The students who cannot initiate any project idea may not graduate on time. Therefore, the coordinator-led method can be implemented to help them select a project title. Manual management of student projects in the coordinator-led method is complicated and inefficient. This paper introduces a web-based application called Student Project Management System (SPMS). The application helps students, project advisors, and faculty administrators manage the project from the beginning to the end. The main features of this system are (i) project title recommendation, (ii) project and team prioritization, (iii) project and team matching, project management and scoring, and report generation. Currently, the system contains 205 projects and 228 users: 201 teams, 25 project advisors, and 2 administrators of the faculty.},
