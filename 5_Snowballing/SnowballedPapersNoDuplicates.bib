@article{snowball_10114529502902983987,
title = {Budgeted testing through an algorithmic lens},
abstract = {Automated testing has been a focus of research for a long time. As such, we tend to think about this in a coverage centric manner. Testing budgets have also driven research such as prioritization and test selection, but as a secondary concern. As our systems get larger, are more dynamic, and impact more people with each change, we argue that we should switch from a coverage centric view to a budgeted testing centric view. Researchers in other fields have designed approximation algorithms for such budgeted scenarios and these are often simple to implement and run. In this paper we present an exemplar study on combinatorial interaction testing (CIT) to show that a budgeted greedy algorithm, when adapted to our problem for various budgets, does almost as well coverage-wise as a state of the art greedy CIT algorithm, better in some cases than a state of the art simulated annealing, and always improves over random. This suggests that we might benefit from switching our focus in large systems, from coverage to budgets.},
doi = {10.1145/2950290.2983987},
year = {2016},
pages = {948-951},
note = {Found via snowballing (OpenAlex)}
}

@article{snowball_101109i2ct4265920189057830,
title = {Enhanced Test Case Prioritization Technique Based on Fix-and-Reschedule Adaptive Approach and Genetic Algorithm},
abstract = {Software testing is self-discipline of application engineering whose goal is to seek out the presence of mistakes within the software. Software checking out starts with the preliminary phase of program progress life cycle. It's a delusion that software checking out indicates the absence of blunders. It is really performed to exhibit the presence of error. The application checking out results in cut back errors diminish down preservation and reduce application expenditures. There are various systems by means of which the system can also be achieved. Checking out is completed to make certain that the product which goes to be produced will achieve the success. This paper implements improvised prioritizing technique by combining “Fix-and-reschedule Adaptive” approach with Genetic algorithm. This paper aims to achieve perfect statement coverage and fault detection in minimum time. Results are validated by comparing proposed technique with the existing techniques by using execution time, APSC and APFD as parameters. Experimental results show that the proposed technique outperforms the existing technique in various parameters.},
