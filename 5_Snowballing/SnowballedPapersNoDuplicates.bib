@article{snowball_10106350193559,
title = {API RESTful in workflow engine: Management of administrative processes, applying the workflow reference model},
abstract = {The growth of development of transactional systems to automate administrative management processes has grown substantially, a situation that has led companies to have data models and components programmed to cover a layer of document services, creating duplication of information and integration difficulties. Therefore, Workflow Management Systems is a transversal solution to improve these drawbacks. This research developed a transactional component to automate any administrative process through Application Programming Interface (API) that follows the representational state transfer (REST) software architecture. Which theoretical and general scientific methods were used in the literature review related to process automation and the international standard for Workflow system: Reference Model, published by the Workflow Management Coalition (WfMC), generating two main phases: 1) focused on the analysis of requirements and the selection of technological tools; 2) focused on product quality, where the life cycle of the system is carried out, from modeling to the application of functional and data load tests. The functionality was validated through the implementation of the core and the integration of the interfaces to automate an administrative process, demonstrating the validity of the standard in conjunction with the technological tools proposed in this work. The created API establishes a baseline so all administrative processes can be automated without developing new document process modules; therefore, it can be replicated with distributed architectures in multiple layers.},
