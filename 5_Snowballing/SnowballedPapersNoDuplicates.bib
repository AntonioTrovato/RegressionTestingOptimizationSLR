@article{snowball_101109compsystech65493202511136917,
title = {Mathematical Approaches for Reliability and Fault Tolerance in IoT-Based Systems: Current Trends and Future Directions},
abstract = {The rapid expansion of the Internet of Things (IoT) has offered many added-value services and applications to people in many aspects. Yet, it introduced critical risks and challenges related to maintaining system reliability and fault tolerance across various applications, due to the extreme heterogeneity and diversification of IoT system architectures. Numerous methods were investigated to sustain the efficiency and effectiveness of IoT-based systems in terms of reliability, robustness, and resilience. This paper reviews the mathematical approaches employed to address these challenges, focusing on fault detection, redundancy strategies, and performance optimization. Current methodologies, including stochastic modeling, optimization frameworks, and predictive algorithms, are analyzed in various IoT contexts. Additionally, emerging trends, such as integrating real-time monitoring and AI-driven models, are discussed.},
