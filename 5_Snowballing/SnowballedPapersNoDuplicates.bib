@article{snowball_101109qrsc65679202500040,
title = {Hybrid Deep Learning Models for Dynamic Warm-Up Iteration Optimization in Performance Testing},
abstract = {Microbenchmarking is a critical method in software performance engineering for evaluating code fragments, detecting performance regressions, and validating optimizations. However, the warm-up phase caused by the Just-In-Time (JIT) compilation in the Java Virtual Machine (JVM) introduces significant performance fluctuations during the initial execution of programs. This makes it challenging to accurately identify the steady-state performance and optimize testing efficiency. Traditional methods often rely on fixed warm-up iteration configurations, which fail to adapt to the dynamic behavior of different code fragments, leading to either insufficient warm-up, causing inaccurate measurements, or excessive warm-up, resulting in unnecessary time consumption. To address these issues, this paper proposes JMH-WIO, a deep learning-based warm-up iteration optimization method. JMH-WIO formulates the problem as a time series classification task and employs a hybrid architecture combining Residual Networks (ResNet) and Fully Convolutional Networks (FCN) to dynamically detect the end of the warm-up phase in real time. This approach enables intelligent and adaptive termination of warm-up iterations, significantly improving testing efficiency while maintaining or enhancing result accuracy. Experimental evaluations on 586 microbenchmarks from 30 open-source projects demonstrate that JMH-WIO outperforms existing methods in steady-state classification, warm-up estimation accuracy, and testing time reduction. These results highlight the practical value of JMH-WIO in optimizing performance testing workflows in resource-constrained environments.},
doi = {10.1109/qrs-c65679.2025.00040},
year = {2025},
pages = {258-267},
note = {Found via snowballing (OpenAlex)}
}

@incollection{snowball_101007978303222375311,
title = {An AI Driven Decision System for Value Aware Regression Testing},
abstract = {Abstract In agile software development, regression testing is an ongoing process activity. However, real-world time constraints necessitate selecting a subset of tests to run. Current regression test selection algorithms primarily focus on technical metrics such as requirement coverage while overlooking the business value each test validates. This study reframes regression test selection as a multi-objective optimization problem in which tests are selected to maximize business value within a constrained testing time while maintaining adequate requirement coverage. We apply an artificial intelligence-based search algorithm, and our results show that the proposed method consistently selects tests with higher business value than baseline approaches when time is limited, while maintaining comparable requirement coverage. These findings suggest that a driven value-aware selector can be incorporated into agile teams for decisions on allocating limited regression testing resources.},
doi = {10.1007/978-3-032-22375-3_11},
year = {2026},
booktitle = {Lecture notes in business information processing},
pages = {175-190},
note = {Found via snowballing (OpenAlex)}
}

