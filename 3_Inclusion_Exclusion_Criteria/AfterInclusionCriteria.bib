@INPROCEEDINGS{7079143,
  author={Sujata and Purohit, G.N.},
  booktitle={2015 Fifth International Conference on Advanced Computing & Communication Technologies}, 
  title={A Schema Support for Selection of Test Case Prioritization Techniques}, 
  year={2015},
  volume={},
  number={},
  pages={547-551},
  abstract={Regression testing is a vast field of research. It is very costly and time consuming process but on the other hand very important process in software testing. Retest all, Test case Selection, Hybrid and Test Case Prioritization are its various techniques which are used to reduce the efforts in maintenance phase. In technical literature several techniques are present with their different and vast number of goals which can be applied in software projects despite of that they have not proven their true efficiency in the testing process. The major problem in regression testing area is to select the test case prioritization technique/s that is effective in such a way that maximum project characteristics should be cover in a minimum time span. However, consideration of this decision be carefully done so that loss of resources can be avoided in a software project. Based on the above scenario, author proposes a selection schema to support the selection of TCP techniques for a given software project aiming at maximizing the coverage of software project characteristics considering aspect of prioritization of software project characteristics. At the end, preliminary results of an experimental evaluation are presented. The purpose of this research is decision should be based on the objective knowledge of the techniques rather than considering some perception and assumptions.},
  keywords={Software;Maintenance engineering;Software algorithms;Software testing;Reliability;Estimation;regression testing;project characteristics;selection schema;test case prioritization techniques},
  doi={10.1109/ACCT.2015.91},
  ISSN={2327-0659},
  month={Feb},}

@INPROCEEDINGS{11166931,
  author={Nader, Abdelrahman and Solayman, Marwa M.},
  booktitle={2025 Intelligent Methods, Systems, and Applications​ (IMSA)}, 
  title={Analyzing Test Case Prioritization approaches With Performance and Speed Trade-Offs in CI Workflows}, 
  year={2025},
  volume={},
  number={},
  pages={376-381},
  abstract={The software testing process is an important activity in software development that helps ensure applications are working properly and meet quality standards. Among testing methodologies, regression testing plays a pivotal role in ensuring that recent changes do not introduce new defects in previous parts of the software. However, as software applications increase in size and complexity, executing all test cases becomes increasingly difficult and time-consuming. Test case prioritization effectively addresses this challenge by identifying and selecting the most likely test cases to fail, optimizing fault detection within the available time constraints. This study provides a comparative analysis of three state-of-the-art test case prioritization techniques: COLEMAN (Combinatorial VOlatiLE Multi-Armed BANdit), Reinforced Test Case Selection (RETECS), and DeepOrder. Each model uses a different approach to prioritize test cases: combinatorial optimization, reinforcement learning and deep learning respectively. The study compares the model’s ability to detect faults earlier in the testing process using various metrics such as Normalized APFD (NAPFD) and prioritization time.},
  keywords={Software testing;Measurement;Fault diagnosis;Fault detection;Reinforcement learning;Software;Time factors;Standards;Optimization;Software development management;Regression Testing;Test Case Prioritization,Software Testing;Reinforcement Learning},
  doi={10.1109/IMSA65733.2025.11166931},
  ISSN={},
  month={July},}

@INPROCEEDINGS{8449552,
  author={Coviello, Carmen and Romano, Simone and Scanniello, Giuseppe},
  booktitle={2018 IEEE/ACM 40th International Conference on Software Engineering: Companion (ICSE-Companion)}, 
  title={Poster: CUTER: ClUstering-based TEst Suite Reduction}, 
  year={2018},
  volume={},
  number={},
  pages={306-307},
  abstract={Test Suite Reduction (TSR) approaches speed up regression testing by removing redundant test cases. TSR approaches can be classified as adequate or inadequate. Adequate approaches reduce test suites so that they completely preserve the test requirements (e.g., statement coverage) of the original test suites. Inadequate approaches produce reduced test suites that only partially preserve the test requirements. We propose a tool prototype for inadequate TSR and named it CUTER (ClUstering-based TEst suite Reduction). CUTER implements a clustering-based approach and a number of instances of its underlying process. We implemented CUTER as an Eclipse plug-in and applied it on 19 versions of four Java programs.},
  keywords={Clustering algorithms;Visualization;Testing;Software;Graphical user interfaces;Software engineering;Java;Regression Testing;Test Suite Reduction;Clustering},
  doi={},
  ISSN={2574-1934},
  month={May},}

