@INPROCEEDINGS{11108378,
  author={Zheng, Xin and Pan, Ya and Luo, Xu},
  booktitle={2025 7th International Conference on Natural Language Processing (ICNLP)}, 
  title={CND: Detecting Functionally Irrelevant Code Changes for Improving Regression Testing}, 
  year={2025},
  volume={},
  number={},
  pages={571-577},
  abstract={Software regression testing is a crucial phase for maintaining software quality. To optimize the cost and efficiency of regression testing, selective test case generation and selection have become essential. Many studies have explored methods for reducing the number of test cases. However, during code changes such as bug fixes, feature additions, or optimizations, a portion of the changes may be functionally irrelevant, referred to as change noise. These changes, although affecting code structure, do not impact the software's behavior, syntax, or semantics. In this paper, we propose a pattern-matching-based approach(CND) to detect change noise. By leveraging techniques such as pattern matching, refactoring detection, and semantic code transformation analysis, our method aims to identify functionally irrelevant changes. Our approach explores 26 types of change noise and detects them effectively. To evaluate our change noise detection method, we selected 10 projects from certain public datasets [4]–[6] and expanded our research dataset by generating new commits through code transformations. The empirical results demonstrate that our method can effectively detect 66.34% of change noise. Additionally, we validated the effectiveness of detecting and removing change noise-related methods on optimizing regression test case selection in a project used for a web vulnerability testing range by a certain company. When applied to the regression test case selection for the project, this reduction in the number of methods associated with change noise indirectly decreases the number of test cases selection and generation, thereby improving regression testing efficiency.},
  keywords={Codes;Noise;Semantics;C++ languages;Software quality;Syntactics;Natural language processing;Pattern matching;Optimization;Testing;information extraction;regression test;code change},
  doi={10.1109/ICNLP65360.2025.11108378},
  ISSN={},
  month={March},
classification = {PS},
idq = {0.4}
}

@INPROCEEDINGS{6743502,
  author={Haider, Aftab Ali and Nadeem, Aamer and Rafiq, Shahzad},
  booktitle={2013 IEEE 9th International Conference on Emerging Technologies (ICET)}, 
  title={Computational intelligence and safe reduction of test suite}, 
  year={2013},
  volume={},
  number={},
  pages={1-6},
  abstract={Systems are frequently regression tested during the maintenance phase due to corrective, preventive, adaptive or perfective actions. Regression testing is used to prevent the undesirable effects of these changes on the previously tested version. Due to these changes, new test cases become part of the test suite making it huge and inefficient for `retest all' strategy. The ultimate solution of this problem is optimization or reduction of the test suite. Computational Intelligence (CI) based approaches like evolutionary computation, fuzzy logic, neural networks and swarm optimization have been used for test suite reduction. Optimization approaches reduce the test suite by compromising its safety. Ideally optimization of test suite must guarantee safe reduction. In this work, we have optimized the test suite using some CI based approaches and then analysed the test suite for `safe reduction'. Safe reduction can be gauged using control flow graphs. Test cases of optimal solutions were traversed on these graphs. We found that these solutions partially cover control flow graph. This showed that optimal solutions returned by CI based approaches except fuzzy logic are not safe and will be inadequate for regression testing.},
  keywords={Optimization;Testing;Genetic algorithms;Particle swarm optimization;Fuzzy logic;Neural networks;test suite optimization;regression testing;multi objective optimization;safe reduction;fuzzy logic;evolutionary algorithms;swarm optimization;computational intelligence},
  doi={10.1109/ICET.2013.6743502},
  ISSN={},
  month={Dec},
classification = {PS},
idq = {0.4}
}

